<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginVertical="3dp"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/timeText"
            android:layout_toLeftOf="@id/timeText"
            android:lines="1"
            android:text="番剧"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/arrow_down" />

        <com.RobinNotBad.BiliClient.ui.widget.TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginVertical="3dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- 主 Tab（3个：新番/追番/索引） -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/top"
        android:orientation="horizontal"
        android:background="?android:attr/colorBackground">

        <TextView android:id="@+id/tab0" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="新番"
            android:textSize="14sp" android:textColor="#FB7299" />
        <TextView android:id="@+id/tab1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="追番"
            android:textSize="14sp" android:textColor="#999999" />
        <TextView android:id="@+id/tab2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="索引"
            android:textSize="14sp" android:textColor="#999999" />
    </LinearLayout>

    <View
        android:id="@+id/tabIndicator"
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:layout_below="@id/tabBar"
        android:background="#FB7299" />

    <!-- 索引筛选栏（双层：主筛选 + 风格标签） -->
    <LinearLayout
        android:id="@+id/filterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tabIndicator"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="6dp">

            <!-- 类型 -->
            <TextView android:text="类型" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#999999" android:paddingHorizontal="4dp" />
            <TextView android:id="@+id/ftTypeAnim" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="动画" android:textSize="13sp" android:textColor="#FFFFFF"
                android:background="@drawable/sel_filter_chip"  />
            <TextView android:id="@+id/ftTypeChina" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="国产" android:textSize="13sp" android:textColor="#666666"
                android:background="@drawable/sel_filter_chip" />

            <View android:layout_width="1dp" android:layout_height="18dp"
                android:layout_marginHorizontal="6dp" android:background="#DDDDDD" />

            <!-- 状态 -->
            <TextView android:text="状态" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#999999" android:paddingHorizontal="4dp" />
            <TextView android:id="@+id/ftStatusAll" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="全部" android:textSize="13sp" android:textColor="#FFFFFF"
                android:background="@drawable/sel_filter_chip"  />
            <TextView android:id="@+id/ftStatusOngoing" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="连载" android:textSize="13sp" android:textColor="#666666"
                android:background="@drawable/sel_filter_chip" />
            <TextView android:id="@+id/ftStatusDone" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="完结" android:textSize="13sp" android:textColor="#666666"
                android:background="@drawable/sel_filter_chip" />

            <View android:layout_width="1dp" android:layout_height="18dp"
                android:layout_marginHorizontal="6dp" android:background="#DDDDDD" />

            <!-- 地区 -->
            <TextView android:text="地区" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#999999" android:paddingHorizontal="4dp" />
            <TextView android:id="@+id/ftAreaAll" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="全部" android:textSize="13sp" android:textColor="#FFFFFF"
                android:background="@drawable/sel_filter_chip"  />
            <TextView android:id="@+id/ftAreaJapan" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="日本" android:textSize="13sp" android:textColor="#666666"
                android:background="@drawable/sel_filter_chip" />
            <TextView android:id="@+id/ftAreaChina" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="中国" android:textSize="13sp" android:textColor="#666666"
                android:background="@drawable/sel_filter_chip" />

            <View android:layout_width="1dp" android:layout_height="18dp"
                android:layout_marginHorizontal="6dp" android:background="#DDDDDD" />

            <!-- 排序 -->
            <TextView android:text="排序" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#999999" android:paddingHorizontal="4dp" />
            <TextView android:id="@+id/ftSortMixed" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="综合" android:textSize="13sp" android:textColor="#666666"
                android:background="@drawable/sel_filter_chip" />
            <TextView android:id="@+id/ftSortHot" android:layout_width="wrap_content"
                android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="12dp"
                android:text="热度" android:textSize="13sp" android:textColor="#FFFFFF"
                android:background="@drawable/sel_filter_chip"  />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 风格标签行（程序化填充） -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/styleRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="6dp" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- 内容区（3 页） -->
    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterBar"
        android:background="?android:attr/colorBackground">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh0" android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler0"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh1" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler1"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh2" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler2"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

</RelativeLayout>
